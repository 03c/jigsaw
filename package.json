{
  "name": "jigsaw",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "dev": "react-router dev",
    "dev:realm": "node ./scripts/prepare-dev-realm.mjs",
    "dev:services:up": "npm run dev:realm && docker compose --env-file .env.local -f docker-compose.local.yml up -d",
    "dev:services:down": "docker compose --env-file .env.local -f docker-compose.local.yml down",
    "dev:services:logs": "docker compose --env-file .env.local -f docker-compose.local.yml logs -f",
    "dev:bootstrap": "npm run dev:services:up && npm run db:push",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@react-router/node": "7.12.0",
    "@react-router/serve": "7.12.0",
    "dockerode": "^4.0.9",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.31",
    "openid-client": "^6.8.2",
    "postgres": "^3.4.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.12.0",
    "systeminformation": "^5.31.1",
    "uuid": "^13.0.0"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@react-router/dev": "7.12.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testcontainers/postgresql": "^11.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.0"
  }
}
